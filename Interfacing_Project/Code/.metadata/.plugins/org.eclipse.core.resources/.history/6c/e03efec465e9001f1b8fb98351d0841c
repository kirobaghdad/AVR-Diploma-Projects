#include <avr/io.h>
#include <avr/interrupt.h>
#include <avr/delay.h>


unsigned int clock[3] = {0};

char prevState = 'x';
char counterState = 'u';

char secondsUp = 'f';
char secondsDown = 'f';

char minutesUp = 'f';
char minutesDown = 'f';

char hoursUp = 'f';
char hoursDown = 'f';

char toggle = 'f';


void displayDigit(int num, int port)
{
	PORTA = (1 << port);
	PORTC = (PORTC & 0xf0) | num;
	_delay_us(10);
}

void displayTimer(void)
{
	// clock[0]
	displayDigit(clock[0] % 10, PA5);
	displayDigit(clock[0] / 10, PA4);

	// clock[1]
	displayDigit(clock[1] % 10, PA3);
	displayDigit(clock[1] / 10, PA2);

	// clock[2]
	displayDigit(clock[2] % 10, PA1);
	displayDigit(clock[2] / 10, PA0);
}

void buzzerON(void)
{
	PORTD |= (1 << 0);
}


ISR(TIMER1_COMPA_vect)
{
	// triggered every one second

	if(counterState == 'u')
	{
		clock[0]++;

		if(clock[0] == 60)
		{
			clock[0] = 0;
			clock[1]++;
		}

		if(clock[1] == 60)
		{
			clock[1] = 0;
			clock[2]++;
		}
	}
	else if(counterState == 'd')
	{
		if(clock[0] == 0)
		{
			if(clock[1])
			{
				clock[0] = 59;
				clock[1]--;
			}
			else if(clock[2])
			{
				clock[2]--;
				clock[1] = 59;
				clock[0] = 59;
			}
			else
			{
				// Trigger the buzzer and stop counting
				counterState = 's';
				buzzerON();
			}
		}
		else
		{
			clock[0]--;
		}
	}
}


ISR(INT0_vect)
{
	// Reset button
	TCNT1 = 0;

	clock[0] = 0;
	clock[1] = 0;
	clock[2] = 0;
	PORTD &= ~(1 << 0);
}

ISR(INT1_vect)
{
	// Pause the counter
	prevState = counterState;
	counterState = 's';
}

ISR(INT2_vect)
{
	// Resume the counter
	if(counterState == 's')
		counterState = prevState;
}




void init_INT0(void)
{
	GICR |= (1 << INT0);
	MCUCR |= (1 << ISC01);
}

void init_INT1(void)
{
	GICR |= (1 << INT1);
	MCUCR |= (1 << ISC11) | (1 << ISC10);
}

void init_INT2(void)
{
	GICR |= (1 << INT2);
	MCUCSR |= (1 << ISC2);
}


void init_TIMER1(void)
{
	TCCR1A |= (1 << FOC1A);
	TCCR1B |= (1 << WGM12) | (1 << CS12);

	TCNT1 = 0;

	OCR1A = 62500;

	TIMSK |= (1 << OCIE1A);
}

void stateLeds(void)
{
	if(counterState == 'u')
	{
		PORTD |= (1 << 4);
		PORTD &= ~(1 << 5);
	}
	else if(counterState == 'd')
	{
		PORTD &= ~(1 << 4);
		PORTD |= (1 << 5);
	}
	else if(prevState == 'u')
	{
		PORTD |= (1 << 4);
		PORTD &= ~(1 << 5);
	}
	else if(prevState == 'd')
	{
		PORTD &= ~(1 << 4);
		PORTD |= (1 << 5);
	}

}

void checkButton(int PIN, char dir, char *buttonName, int index)
{
	if(!(PINB & (1 << PIN)))
	{

		if(*buttonName == 'f')
		{
			// overflow checks
			if(dir == 'u')
			{
				if(index < 2)
				{
					clock[index] = (clock[index] + 1) % 60;
				}
				else
				{
					clock[index] = (clock[index] + 1) % 100;
				}

			}
			else
			{
				if(clock[index] != 0)
					clock[index]--;
			}

			*buttonName = 't';
		}

	}
	else
	{
		*buttonName = 'f';
	}

}


int main(void)
{
	init_INT0();
	init_INT1();
	init_INT2();
	init_TIMER1();

	// I-bit
	SREG |= (1 << 7);
	// pins configuration
	DDRA |= 0x3F;
	DDRC |= 0x0F;
	DDRD &= ~(1 << 2) & ~(1 << 3) & ~(1 < 0);
	DDRD |= (1 << 4) | (1 << 5); // LEDs
	DDRB = 0;

	// internal Pull-Up
	PORTB = 0xFF;
	PORTD |= (1 << 2);


	// initialization
	PORTA = 0;
	PORTC = 0;
	PORTD |= (1 << 4);
	PORTD &= ~(1 << 5);


	while(1)
	{
		// display
		displayTimer();

		// Toggle Button
		if(!(PINB & (1 << 7)))
		{
			if(toggle == 'f')
			{
				if(counterState == 's')
				{
					if(prevState == 'd')
					{
						prevState = 'u';
					}
					else
						prevState = 'd';
				}
				else
				{
					if(counterState == 'd')
						counterState = 'u';
					else
						counterState = 'd';
				}

				toggle = 't';
			}
		}
		else
		{
			toggle = 'f';
		}

		// Adjustment Buttons
		if(counterState == 's' && prevState == 'd')
		{
			// hours
			checkButton(PB1, 'u', &hoursUp, 2);
			checkButton(PB0, 'd', &hoursDown, 2);

			// minutes
			checkButton(PB4, 'u', &minutesUp, 1);
			checkButton(PB3, 'd', &minutesDown, 1);

			// seconds
			checkButton(PB6, 'u', &secondsUp, 0);
			checkButton(PB5, 'd', &secondsDown, 0);

		}

		stateLeds();
	}


	return 0;
}

#include <avr/io.h>
#include <avr/delay.h>
#include "ultrasonic.h"
#include "../HAL/led.h"
#include "../MCAL/gpio.h"
#include "../MCAL/icu.h"

volatile uint8 count = 0;

volatile uint16 fallingTime = 100;

void Ultrasonic_init(void)
{
	ICU_ConfigType Config_Ptr = {F_CPU_8, RISING};

 	ICU_init(&Config_Ptr);

	ICU_setCallBack(Ultrasonic_edgeProcessing);


	GPIO_setupPinDirection(ICU_TRIGGER_PORT, ICU_TRIGGER_PIN, PIN_OUTPUT);
}

void Ultrasonic_Trigger(void)
{
	GPIO_writePin(ICU_TRIGGER_PORT, ICU_TRIGGER_PIN, LOGIC_HIGH);

	_delay_us(10);

	GPIO_writePin(ICU_TRIGGER_PORT, ICU_TRIGGER_PIN, LOGIC_LOW);

}

 uint16 Ultrasonic_readDistance(void)
 {
// 	LED_on(GREEN);

 	ICU_setEdgeDetectionType(RISING);
 	count = 0;
 	Ultrasonic_Trigger();


 	while(count != 2);

// 	ICU_deInit();

 	float timeInSeconds = (fallingTime) * (1 / (16000000 + 0.0));

 	return timeInSeconds * 34300;
 }


void Ultrasonic_edgeProcessing(void)
{
	if(count != 2)
		count++;

	if(count == 1)
	{
		ICU_clearTimerValue();

		ICU_setEdgeDetectionType(FALLING);
	}
	else if(count == 2)
	{
		fallingTime = ICU_getInputCaptureValue();
	 	ICU_setEdgeDetectionType(RISING);
	}



}
